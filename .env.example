# Copy this file to .env and fill in the values. .env is git-ignored — never commit it.
#   cp .env.example .env

# PostgreSQL (used by docker compose and by cyberpath-api)
DB_NAME=cyberpath
DB_USER=cyberpath
DB_PASSWORD=change-me

# Host port PostgreSQL is published on (127.0.0.1 only). Used by cyberpath-api when it runs outside Docker.
DB_PORT=5434
